# =============================================================================
# Axiocruit Enterprise Platform — Environment Configuration Template
# Copy this file to `server/.env` or `.env` and fill in the required secrets.
# =============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/axiocruit

# Security & Authentication
JWT_SECRET=axiocruit_enterprise_jwt_secret_dev_only_change_in_prod

# Python Environment
PYTHON_BIN=python

# Microservices Network Routing
AI_SERVICE_URL=http://localhost:8002
PROCTORING_SERVICE_URL=http://localhost:8001

# AI & LLM Providers (Optional for Adaptive Code Grading and Summaries)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Stripe Billing & Checkout (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
