# =================================================================
# PROCRUIT ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# Copy this file to server/.env or configure these variables in your
# container orchestration platform (Kubernetes / ECS / Docker Swarm).

# --- Application Runtime ---
NODE_ENV=production
PORT=5001

# --- Security & Authentication ---
# Generate a strong 256-bit random secret for production (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# --- Database ---
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/procruit?retryWrites=true&w=majority
# For Local/Docker: mongodb://localhost:27017/procruit
MONGO_URI=mongodb://localhost:27017/procruit

# --- Microservices Endpoints ---
# AI Service (FastAPI NLP Engine for CV Parsing & Semantic Scoring)
AI_SERVICE_URL=http://localhost:8002

# Proctoring Service (FastAPI MediaPipe Landmarker & WebSocket Proctoring)
PROCTORING_SERVICE_URL=http://localhost:8001

# Frontend Web Origin (Allowed CORS Origin)
CLIENT_URL=http://localhost:3000

# --- Payment & Billing (Optional) ---
# Stripe Secret API Key (begins with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=
# Stripe Webhook Signing Secret (begins with whsec_)
STRIPE_WEBHOOK_SECRET=

# --- AI LLM Integration (Optional) ---
# Local Ollama endpoint or remote LLM gateway
OLLAMA_URL=http://localhost:11434

# --- Rate Limiting Control ---
# Set to 'true' to disable rate limiting during automated load testing
DISABLE_RATE_LIMIT=false
